{
  "name": "exceljs",
  "version": "5.0.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exceljs/exceljs.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./excel.js",
  "browser": "./dist/exceljs.min.js",
  "types": "./index.d.ts",
  "files": [
    "dist",
    "lib",
    "excel.js",
    "LICENSE",
    "README.md",
    "README_zh.md",
    "index.ts",
    "index.d.ts"
  ],
  "scripts": {
    "test": "bun run test:unit && bun run test:integration && bun run test:end-to-end",
    "test:unit": "mocha --require spec/config/setup --require spec/config/setup-unit spec/unit --recursive",
    "test:integration": "mocha --require spec/config/setup spec/integration --recursive",
    "test:end-to-end": "mocha --require spec/config/setup spec/end-to-end --recursive",
    "test:dist": "mocha --require spec/config/setup spec/dist --recursive",
    "test:manual": "node spec/manual/app.js",
    "test:typescript": "mocha -r tsx spec/typescript/**/*.spec.ts",
    "lint": "eslint --format node_modules/eslint-friendly-formatter .",
    "clean": "rm -rf build/ && rm -rf dist",
    "benchmark": "node --expose-gc benchmark",
    "build": "grunt build"
  },
  "lint-staged": {
    "*.js": [
      "prettier-eslint --write",
      "eslint --format node_modules/eslint-friendly-formatter",
      "git add"
    ]
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "spreadsheet",
    "workbook",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup"
  ],
  "dependencies": {
    "archiver": "^7.0.1",
    "dayjs": "^1.11.23",
    "fast-csv": "^5.0.8",
    "jszip": "^3.10.2",
    "saxes": "^6.0.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@noble/hashes": "^2.4.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "buffer": "^6.0.3",
    "chai": "^6.3.0",
    "chai-datetime": "^1.8.1",
    "chai-xml": "^0.4.1",
    "dirty-chai": "^3.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "events": "^3.3.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mocha": "^12.0.3",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "string_decoder": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "util": "^0.12.5"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "glob": "^14.0.5",
    "minimatch": "^11.0.8"
  }
}
