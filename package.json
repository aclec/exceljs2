{
  "name": "exceljs",
  "version": "5.0.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exceljs/exceljs.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./excel.js",
  "browser": "./dist/exceljs.min.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./dist/exceljs.min.js",
      "default": "./excel.js"
    },
    "./package.json": "./package.json",
    "./excel": "./excel.js",
    "./excel.js": "./excel.js",
    "./dist/*": "./dist/*",
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js"
  },
  "files": [
    "dist",
    "lib",
    "excel.js",
    "index.d.ts",
    "LICENSE",
    "README.md",
    "README_zh.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "bun run test:unit && bun run test:integration && bun run test:end-to-end",
    "test:unit": "mocha --require spec/config/setup.js --require spec/config/setup-unit.js spec/unit --recursive",
    "test:integration": "mocha --require spec/config/setup.js spec/integration --recursive",
    "test:end-to-end": "mocha --require spec/config/setup.js spec/end-to-end --recursive",
    "test:bun": "bun --bun mocha --require spec/config/setup.js --require spec/config/setup-unit.js spec/unit --recursive && bun --bun mocha --require spec/config/setup.js spec/integration --recursive && bun --bun mocha --require spec/config/setup.js spec/end-to-end --recursive",
    "test:browser": "mocha --require spec/config/setup.js spec/browser",
    "test:dist": "mocha --require spec/config/setup.js spec/dist",
    "test:typescript": "mocha --require spec/config/setup.js --import=tsx 'spec/typescript/**/*.spec.ts'",
    "test:types": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "bun audit",
    "benchmark": "node --expose-gc benchmark.js",
    "check:install-scripts": "node scripts/check-install-scripts.mjs",
    "prepublishOnly": "bun run build && bun run test:dist",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,json,md,yml,yaml}": "prettier --write"
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "spreadsheet",
    "workbook",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup"
  ],
  "dependencies": {
    "archiver": "^7.0.1",
    "dayjs": "^1.11.23",
    "fast-csv": "^5.0.8",
    "jszip": "^3.10.2",
    "saxes": "^6.0.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@noble/hashes": "^2.4.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "buffer": "^6.0.3",
    "chai": "^6.3.0",
    "chai-datetime": "^1.8.1",
    "chai-xml": "^0.4.1",
    "dirty-chai": "^3.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "events": "^3.3.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mocha": "^12.0.3",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "string_decoder": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "util": "^0.12.5"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "glob": "^14.0.5",
    "minimatch": "^11.0.8"
  },
  "trustedDependencies": []
}
