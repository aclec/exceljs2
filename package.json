{
    "name": "@aclec/exceljs2",
    "version": "5.0.0",
    "description": "Excel Workbook Manager - Read and Write xlsx and csv Files. Maintained fork of exceljs: up-to-date dependencies and security fixes.",
    "private": false,
    "license": "MIT",
    "author": {
        "name": "Guyon Roche",
        "email": "guyon@live.com"
    },
    "contributors": [
        "aclec (maintainer of the fork)"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aclec/exceljs2.git"
    },
    "bugs": {
        "url": "https://github.com/aclec/exceljs2/issues"
    },
    "homepage": "https://github.com/aclec/exceljs2#readme",
    "engines": {
        "node": ">=22.12.0"
    },
    "main": "./excel.js",
    "browser": "./dist/exceljs.min.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "browser": "./dist/exceljs.min.js",
            "default": "./excel.js"
        },
        "./package.json": "./package.json",
        "./excel": "./excel.js",
        "./excel.js": "./excel.js",
        "./dist/*": "./dist/*",
        "./lib/*.js": "./lib/*.js",
        "./lib/*.json": "./lib/*.json",
        "./lib/*.xml": "./lib/*.xml",
        "./lib/*": "./lib/*.js"
    },
    "files": [
        "dist",
        "lib",
        "src",
        "excel.js",
        "index.d.ts",
        "LICENSE",
        "README.md",
        "README_zh.md",
        "CHANGELOG.md",
        "UPGRADE-5.0.md",
        "SECURITY.md"
    ],
    "scripts": {
        "build:lib": "node scripts/build-lib.mjs",
        "build": "node scripts/build-lib.mjs && node scripts/build.mjs",
        "test": "bun run build:lib && bun run test:unit && bun run test:integration && bun run test:end-to-end",
        "test:unit": "mocha --require spec/config/setup.js --require spec/config/setup-unit.js spec/unit --recursive",
        "test:integration": "mocha --require spec/config/setup.js spec/integration --recursive",
        "test:end-to-end": "mocha --require spec/config/setup.js spec/end-to-end --recursive",
        "test:bun": "bun run build:lib && bun --bun mocha --require spec/config/setup.js --require spec/config/setup-unit.js spec/unit --recursive && bun --bun mocha --require spec/config/setup.js spec/integration --recursive && bun --bun mocha --require spec/config/setup.js spec/end-to-end --recursive",
        "test:browser": "mocha --require spec/config/setup.js spec/browser",
        "test:dist": "mocha --require spec/config/setup.js spec/dist",
        "test:typescript": "bun run build:lib && mocha --require spec/config/setup.js --import=tsx 'spec/typescript/**/*.spec.ts'",
        "test:types": "tsc -p tsconfig.json && tsc -p tsconfig.types.json",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "audit": "bun audit",
        "benchmark": "bun run build:lib && node --expose-gc benchmark.js",
        "benchmark:suite": "bun run build:lib && node --expose-gc scripts/bench-suite.mjs",
        "check:install-scripts": "node scripts/check-install-scripts.mjs",
        "prepublishOnly": "bun run build && bun run test:dist",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,cjs,mjs,ts}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": "prettier --write"
    },
    "keywords": [
        "xlsx",
        "json",
        "csv",
        "excel",
        "font",
        "border",
        "fill",
        "number",
        "format",
        "number format",
        "alignment",
        "office",
        "spreadsheet",
        "workbook",
        "defined names",
        "data validations",
        "rich text",
        "in-cell format",
        "outlineLevel",
        "views",
        "frozen",
        "split",
        "pageSetup"
    ],
    "dependencies": {
        "dayjs": "^1.11.23",
        "fast-csv": "^5.0.8",
        "fflate": "^0.8.3",
        "saxes": "^6.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@noble/hashes": "^2.4.0",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.20.5",
        "buffer": "^6.0.3",
        "chai": "^6.3.0",
        "chai-datetime": "^1.8.1",
        "chai-xml": "^0.4.1",
        "dirty-chai": "^3.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-n": "^18.5.0",
        "events": "^3.3.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "mocha": "^12.0.3",
        "playwright-core": "^1.65.0",
        "prettier": "^3.10.1",
        "process": "^0.11.10",
        "stream-browserify": "^3.0.0",
        "string_decoder": "^1.3.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0"
    },
    "packageManager": "bun@1.4.4",
    "overrides": {
        "glob": "^14.0.5",
        "minimatch": "^11.0.8"
    },
    "trustedDependencies": [],
    "publishConfig": {
        "access": "public"
    }
}
