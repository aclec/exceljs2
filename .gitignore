# Dependencies (bun.lock is the lockfile; package-lock.json / yarn.lock / pnpm-lock.yaml are ignored
# so that a stray `npm install` does not get committed)
node_modules
package-lock.json
npm-shrinkwrap.json
yarn.lock
pnpm-lock.yaml
.npmrc

# Build output (bun run build)
/dist/
/build/

# Packed tarballs (bun pm pack / npm pack)
*.tgz

# Test output and coverage
/out/
spec/out/*
!spec/out/README.md
/coverage/
/.nyc_output/
*.xlsx

# gold internals
spec/integration/data/gold

# Playwright artefacts (browser tests use a temporary profile, these only appear when debugging)
/test-results/
/playwright-report/

# graphify code map: local only (community ids are not stable between rebuilds, so committing it would
# churn on every commit). Rebuilt by .husky/post-commit and post-checkout, or `graphify update .`
/graphify-out/

# optional switch off tests
.disable-test-*

# Logs and runtime data
logs
*.log
*.pid
*.seed

# Editors and OS files
.idea
.vscode
exceljs.iml
.DS_Store
Thumbs.db

# Temporary files
/tmp/
/tasks/

# Compiled from src/ by `bun run build:lib` (tsc -p tsconfig.build.json)
/lib/

# Claude Code: agent worktrees (local copies of the repository) and personal settings
/.claude/worktrees/
/.claude/settings.local.json
