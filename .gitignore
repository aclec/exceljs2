# Dependencies (bun.lock is the lockfile; package-lock.json / yarn.lock / pnpm-lock.yaml are ignored
# so that a stray `npm install` does not get committed)
node_modules
package-lock.json
npm-shrinkwrap.json
yarn.lock
pnpm-lock.yaml
.npmrc

# Build output (bun run build)
/dist/
/build/

# Packed tarballs (bun pm pack / npm pack)
*.tgz

# Test output and coverage
/out/
spec/out/*
!spec/out/README.md
/coverage/
/.nyc_output/
*.xlsx

# gold internals
spec/integration/data/gold

# Playwright artefacts (browser tests use a temporary profile, these only appear when debugging)
/test-results/
/playwright-report/

# graphify: keep GRAPH_REPORT.md and graph.json, ignore the cache and generated HTML
/graphify-out/cache/
/graphify-out/*.html

# optional switch off tests
.disable-test-*

# Logs and runtime data
logs
*.log
*.pid
*.seed

# Editors and OS files
.idea
.vscode
exceljs.iml
.DS_Store
Thumbs.db

# Temporary files
/tmp/
