# Refresh the local graphify code map (graphify-out/, gitignored) in the background after each commit.
# No-op when graphify is not installed, when no graph was built yet, or during merges/rebases.
command -v graphify >/dev/null 2>&1 || exit 0
[ -d graphify-out ] || exit 0
GIT_DIR=$(git rev-parse --git-dir)
if [ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ] || [ -f "$GIT_DIR/MERGE_HEAD" ] || [ -f "$GIT_DIR/CHERRY_PICK_HEAD" ]; then
    exit 0
fi
mkdir -p "$HOME/.cache"
nohup graphify update . >"$HOME/.cache/graphify-rebuild.log" 2>&1 </dev/null &
